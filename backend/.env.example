# Google Gemini Developer API (free tier) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AQ.Ab8RN6L3sx8iT9rtvLMMegTBGRu2oispUv1YBV0GGBVfxhWI9Q

# Any current Gemini free-tier model name. Change this without touching code.
# Examples at time of writing: gemini-1.5-flash, gemini-1.5-flash-8b, gemini-2.0-flash
GEMINI_MODEL=gemini-1.5-flash

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# Limits
MAX_CODE_SIZE=100000
MAX_REQUEST_SIZE=200000

# Gemini call behavior
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_RETRIES=2

# Security: leave false unless you have properly sandboxed this deployment.
ENABLE_CODE_EXECUTION=false
